# ============================================================================
# Konfigurasi Worker Volume-Level (distributed-experiment)
# Salin ke .env lalu sesuaikan per node. Muat dengan: set -a; . ./.env; set +a
# (Git Bash) atau gunakan --flag pada publish/collect.
# ============================================================================

# --- Koneksi ke MASTER (laptop) lewat Tailscale ---
RABBITMQ_HOST=100.110.113.24
RABBITMQ_PORT=5674
RABBITMQ_USER=brainnav
RABBITMQ_PASS=BrainNav_Secure_2025!
RABBITMQ_VHOST=brainnav_vhost
VOLUME_QUEUE=segmentation_volume_tasks

REDIS_URL=redis://:BrainNav_Secure_2025!@100.110.113.24:6381/0
RESULT_TTL=86400

# --- Model nnU-Net (pastikan folder model ADA di tiap node) ---
NNUNET_MODEL_FOLDER=./nnUnet-Papavero
NNUNET_FOLDS=0,1,2,3,4
NNUNET_CHECKPOINT=checkpoint_final.pth
DEVICE=cuda

# --- Identitas worker (BEDA per node) ---
# Laptop : WORKER_NAME=master-3050ti  GPU_TYPE=rtx-3050ti-mobile  METRICS_PORT=8000
# PC-A   : WORKER_NAME=pc-a-5080      GPU_TYPE=rtx-5080            METRICS_PORT=8001
# PC-B   : WORKER_NAME=pc-b-5080      GPU_TYPE=rtx-5080            METRICS_PORT=8001
WORKER_NAME=master-3050ti
GPU_TYPE=rtx-3050ti-mobile
METRICS_PORT=8000

# --- Payload ---
# reference (default): message kecil; worker baca file lokal SCAN_DIR/<scan_id>.nii.gz.
#                      Wajib copy scan ke tiap node sekali (lihat README).
# base64            : volume di-embed di message (~120MB/task). Hanya untuk
#                      mengukur communication overhead; berisiko limit broker.
PAYLOAD_MODE=reference
SCAN_DIR=./scans

LOG_LEVEL=INFO
