# ============================================================================
# WORKER IDENTITY — PC-B (1× RTX 5080)
# ============================================================================
WORKER_NAME=pc-b-worker
WORKER_NODE_NAME=pc-b
GPU_TYPE=RTX5080
CLUSTER_MODES=homogen

# ============================================================================
# MASTER (Tailscale IP) — dipakai docker-compose.yml untuk substitute
# ${MASTER_IP} di environment block. JANGAN dihilangkan, karena default
# di compose adalah IP lab lama (10.28.83.141).
# ============================================================================
MASTER_IP=100.110.113.24

# ============================================================================
# RABBITMQ (Master via Tailscale)
# ============================================================================
RABBITMQ_HOST=100.110.113.24
RABBITMQ_PORT=5674
RABBITMQ_USER=brainnav
RABBITMQ_PASS=BrainNav_Secure_2025!
RABBITMQ_VHOST=brainnav_vhost
RABBITMQ_URL=amqp://brainnav:BrainNav_Secure_2025!@100.110.113.24:5674/brainnav_vhost

# ============================================================================
# REDIS (Master via Tailscale)
# ============================================================================
REDIS_HOST=100.110.113.24
REDIS_PORT=6381
REDIS_PASSWORD=BrainNav_Secure_2025!
REDIS_URL=redis://:BrainNav_Secure_2025!@100.110.113.24:6381/0

# ============================================================================
# QUEUES
# ============================================================================
QUEUE_HOMOGEN=segmentation_tasks_homogen
QUEUE_HETEROGEN=segmentation_tasks_heterogen
QUEUE_LEGACY=segmentation_tasks

# ============================================================================
# WORKER RUNTIME
# ============================================================================
PREFETCH_COUNT=1
RESULT_TTL_SECONDS=3600
MODEL_PATH=/app/best_metric_model.pth
LOG_LEVEL=INFO